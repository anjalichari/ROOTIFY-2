# ROOTIFY AI Chatbot Configuration
# Google Gemini API is recommended for Rooty AI Guide
# Get your key from: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI API Alternative
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Server port (for standalone server: npm run server)
PORT=5000
